{"id":"academic-target-frozen-01","prompt":"为这个研究问题建立不可漂移的 Target：冻结语句、给出 statement_hash 并限定范围。","expected":{"trigger":true,"academic":true,"must_output":["frozen target statement","statement_hash","scope included/excluded"],"must_not":["unversioned target"]}}
{"id":"academic-three-round-loop-01","prompt":"做一次完整学术检索：先粗检索，再按子主题检索，最后做引文/利益关系/基础数据的精细核对。","expected":{"trigger":true,"academic":true,"must_output":["coarse round","subtheme round","fine round"],"phase_order":["coarse","subtheme","fine"],"must_not":["single monolithic query"]}}
{"id":"academic-theme-topology-01","prompt":"把研究目标拆成根主题和若干子主题，并用 sub_n 标注父子关系。","expected":{"trigger":true,"academic":true,"must_output":["root theme","sub_n parent-child topology","versioned themes"],"must_not":["flat unversioned theme list"]}}
{"id":"academic-interest-funding-01","prompt":"整理证据时逐条记录利益关系、资金来源和证据家族，用于政策或合规决策。","expected":{"trigger":true,"academic":true,"must_output":["interest declaration","funding source","evidence family"],"must_not":["bare bibliography"]}}
{"id":"academic-locator-real-01","prompt":"每条证据必须给出真实可核验的定位符（URL/DOI/arXiv/PMID），拒绝伪造来源。","expected":{"trigger":true,"academic":true,"must_output":["real locator per evidence"],"must_not":["fabricated locator"]}}
{"id":"academic-round-gates-01","prompt":"每一轮检索后都要做数据清洗、项目审核和回归门，通过后才进入下一轮。","expected":{"trigger":true,"academic":true,"must_output":["per-round cleaning","per-round review","regression gate"],"must_not":["skip gate"]}}
